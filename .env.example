# Inference Provider Selection ('ollama' or 'cloud')
# Defaults to 'ollama' if Ollama is running or no cloud key is provided, or 'cloud' if API key is set.
LLM_PROVIDER=ollama

# Local Ollama Inference Configuration (e.g. NVIDIA Nemotron 3.5 Bolt E4B)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=nemotron-3.5-bolt:e4b
OLLAMA_TIMEOUT=60.0

# Cloud Inference Configuration (Nebius Token Factory / OpenRouter)
# Obtain your key from https://tokenfactory.nebius.com or https://openrouter.ai
OPENROUTER_API_KEY=your-openrouter-api-key-here
NEBIUS_API_KEY=your-nebius-api-key-here
NEBIUS_BASE_URL=https://openrouter.ai/api/v1
NEBIUS_MODEL_ID=nvidia/nemotron-3-nano-30b-a3b

# Aegis AI Configuration
# Root path for safe coding workspace operations (relative to project root or absolute)
AEGIS_WORKSPACE=./workspace

# SQLite database file path
AEGIS_DATABASE_PATH=./aegis.db

# Host and Port settings (Defaults to localhost 127.0.0.1 for security)
AEGIS_HOST=127.0.0.1
AEGIS_PORT=8000
AEGIS_DEBUG=false
